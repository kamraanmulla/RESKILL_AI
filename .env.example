# ReSkillAI Frontend Environment Configuration

# Desktop Web Development (Vite dev server proxies /api to http://127.0.0.1:8000)
VITE_API_BASE_URL=/api

# Android Emulator (10.0.2.2 automatically reaches host computer's port 8000)
# VITE_API_BASE_URL=http://10.0.2.2:8000/api

# Physical Android Phone on same Wi-Fi (replace with your development computer's LAN IP)
# VITE_API_BASE_URL=http://192.168.1.50:8000/api

# Production Deployment (Cloud FastAPI endpoint)
# VITE_API_BASE_URL=https://api.reskillai.com/api
